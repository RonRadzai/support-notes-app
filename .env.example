# Copy to .env and adjust. Every value here is a placeholder.
# The app runs end to end with this file untouched: the helpdesk integration uses a mock adapter.

# ── Runtime ─────────────────────────────────────────────────────────────────
# Set to false to call the real Zendesk API with the credentials below.
MOCK_INTEGRATIONS=true
# Backend port. The React dev server proxies /api/* here (see "proxy" in package.json).
PORT=3001
# Origin allowed by CORS. Only matters when the UI is served from a different origin than the API.
ALLOWED_ORIGIN=http://localhost:3000

# ── Data locations (all relative to the project root, all ignored by git) ───
# SQLite file. Created by `npm run seed`.
DB_PATH=./data/app.db
# Organization and contact lookup lists used by the typeahead fields. Written by the seed and
# appended to by the app whenever a note introduces a new organization or contact.
ORGS_CSV_PATH=./data/orgs.csv
USERS_CSV_PATH=./data/users.csv
# Uploaded screenshots, nightly CSV and .db backups, escalation recipients, sync error log.
SCREENSHOT_DIR=./data/screenshots
BACKUP_DIR=./data/backups
RECIPIENTS_PATH=./data/recipients.json
SYNC_ERROR_LOG=./data/sync-errors.log

# ── Helpdesk (Zendesk) ──────────────────────────────────────────────────────
# OAuth client using the client_credentials grant. Create a confidential OAuth client in
# Zendesk Admin Center (Apps and integrations > APIs > OAuth clients). Used only when
# MOCK_INTEGRATIONS=false; the integration stays disabled if any of the three is blank.
ZENDESK_SUBDOMAIN=your-subdomain
ZENDESK_CLIENT_ID=your-zendesk-client-id
ZENDESK_CLIENT_SECRET=your-zendesk-client-secret
ZENDESK_OAUTH_SCOPE=read write
# Key of the Zendesk custom object that stores one record per session note.
ZENDESK_NOTES_OBJECT_KEY=session_notes
# Organization custom field that holds your internal account number, used to link notes and
# tickets to the right Zendesk organization.
ZENDESK_ORG_ACCOUNT_FIELD=account_number
# Optional numeric ids of ticket custom fields to populate on created tickets. Leave blank to skip.
ZENDESK_TICKET_FIELD_CUSTOMER_NAME=
ZENDESK_TICKET_FIELD_ACCOUNT_NUMBER=
ZENDESK_TICKET_FIELD_CRM_ORG_ID=
# Tag applied to every ticket created from the app.
ZENDESK_TICKET_TAG=support-session

# ── Alerts ──────────────────────────────────────────────────────────────────
# Optional incoming-webhook URL (Slack or Teams style) that receives sync failure alerts.
ALERT_WEBHOOK_URL=

# ── Frontend (read at build time by Create React App) ───────────────────────
# Optional link shown in the header, for example the standing video call used for support sessions.
REACT_APP_MEETING_URL=
